@* One line per deployable: the version the deployment pinned in Git, whether the nodes run it, and the links to the
   project that deploys it and to the history of the pins. *@
<div class="versions versions--@(Assessment is { } known ? Level(known.State) : "links")">
    @if (Assessment is { } assessment)
    {
        <p class="versions__pinned" title="@PinnedHelp">
            <VersionIcon State="assessment.State" />
            <strong>@assessment.Headline</strong>
        </p>
        @if (assessment.Detail is { } detail)
        {
            <p class="versions__detail">@detail</p>
        }
    }
    @if (ProjectUrl is not null || HistoryUrl is not null)
    {
        <p class="versions__links">
            @if (ProjectUrl is { } project)
            {
                <a href="@project.AbsoluteUri" target="_blank" rel="noopener"
                   aria-label="@($"Octopus project of {DeployableName} (opens in a new tab)")"
                   title="@($"The Octopus Deploy project that deploys {DeployableName} (opens in a new tab)")">Octopus project</a>
            }
            @if (HistoryUrl is { } history)
            {
                <a href="@history.AbsoluteUri" target="_blank" rel="noopener"
                   aria-label="@($"Pin history of {EnvironmentName} (opens in a new tab)")"
                   title="@($"The history of {PinnedVersions.FileName} of {EnvironmentName} on GitHub (opens in a new tab)")">Pin history</a>
            }
        </p>
    }
</div>

@code {
    /// <summary>Null when the topology names no versions.json for the environment: the line then holds the links only.</summary>
    [Parameter]
    public VersionAssessment? Assessment { get; set; }

    [Parameter, EditorRequired]
    public string DeployableName { get; set; } = default!;

    [Parameter, EditorRequired]
    public string EnvironmentName { get; set; } = default!;

    [Parameter]
    public Uri? ProjectUrl { get; set; }

    [Parameter]
    public Uri? HistoryUrl { get; set; }

    private string PinnedHelp =>
        $"Pinned: the version the last deployment of {DeployableName} to {EnvironmentName} committed to "
        + $"{PinnedVersions.FileName} in the system repository. It is compared with the version each node reports.";

    /// <summary>The style of a state: in sync, differs, or neutral for everything that is not known.</summary>
    internal static string Level(VersionState state) => state switch
    {
        VersionState.InSync => "insync",
        VersionState.Differs => "differs",
        _ => "unknown",
    };
}
